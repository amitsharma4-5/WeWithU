# ==========================================
# WEWITHYOU - CLIENT ENVIRONMENT VARIABLES
# ==========================================

# 1. Firebase Web App Configuration (From Firebase Console -> Project Settings -> General -> Your apps -> Web)
VITE_FIREBASE_APIKEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# 2. Razorpay Key ID (From Razorpay Dashboard -> Settings -> API Keys -> Key Id)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# 3. Backend API URL (Optional in dev, defaults to http://localhost:8000. In production, set to your backend deployment URL)
# VITE_API_URL=http://localhost:8000
