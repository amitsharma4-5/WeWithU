# ==========================================
# WEWITHYOU - SERVER ENVIRONMENT VARIABLES
# ==========================================

# 1. Server Port
PORT=8000

# 2. MongoDB Connection String (From MongoDB Atlas -> Database -> Connect -> Drivers)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wewithyou?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://your_username:your_password@your_cluster.mongodb.net/wewithyou?retryWrites=true&w=majority

# 3. JWT Secret (Any long random string used to sign session tokens)
JWT_SECRET=your_super_secret_jwt_random_string_here

# 4. Groq Cloud AI API Key (From https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Razorpay API Keys (From Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# 6. Frontend URL (Optional, for production CORS, e.g. https://your-domain.vercel.app)
# FRONTEND_URL=http://localhost:5173
